# tests/.env.example — copy to tests/.env and adjust for your local setup
# Playwright uses dotenv automatically when .env is present in the config dir.

# Base URL of your local WordPress Docker instance
LGW_BASE_URL=http://localhost:8080

# Page with [lgw_division] shortcode (must exist on the local WP site)
LGW_TEST_PAGE=/test-division/

# Docker container name for WP-CLI calls
WP_CONTAINER=lgw-local_wordpress_1

# WordPress admin credentials
WP_USER=DamienBintley
WP_PASS=password
